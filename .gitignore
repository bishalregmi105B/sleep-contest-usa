# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Real env files hold secrets. .env.example is the documented template and must
# be tracked, so it is re-included explicitly below the wildcard.
.env*
!.env.example

# vercel
.vercel
.vercel/output

# typescript
*.tsbuildinfo
next-env.d.ts

# Local SQLite, wherever it lands. Never commit a database or a .env.
dev.db
dev.db-journal
*.db
*.db-journal
prisma/*.db
public/assets/generated/
test-results/
playwright-report/

# preview mode: a seeded SQLite database, regenerated on demand
/.preview/
*preview.db

# local dev server logs
*.log
dev.log

# browser automation scratch
.playwright-mcp/
