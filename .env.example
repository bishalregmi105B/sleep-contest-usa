# ---------------------------------------------------------------------------
# Copy to .env.local for development:  cp .env.example .env.local
#
# Development is forgiving; production is not. `npm run dev` and the test suite
# run with most of these blank. In production the server REFUSES TO BOOT if any
# of the REQUIRED variables below is missing, because every failure mode it
# guards is silent: you would lose registrations, or hand out prize eligibility
# without taking payment, and neither shows up until a client notices.
#
# Required-in-production variables are marked REQUIRED.
# ---------------------------------------------------------------------------

# Canonical public origin. REQUIRED in production, and must be https: every
# ticket link in a confirmation email and the canonical URL in the JSON-LD,
# robots.txt and sitemap are built from it. A wrong value points registrants at
# a private machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (REQUIRED in production)
# ---------------------------------------------------------------------------

# Pooled connection string, used by the running app.
#
# On serverless this MUST be a pooled URL. Neon, Supabase, Render and Railway
# all provide one. Append `connection_limit=1` if your provider does not set it:
# every serverless instance opens its own pool, and a hundred instances times
# ten connections will exhaust the database plan.
DATABASE_URL="postgresql://user:password@host:5432/db?connection_limit=1"

# Direct (non-pooled) connection string, used only by `prisma migrate`.
# REQUIRED alongside a pooled DATABASE_URL so migrations do not run through the
# pool and stall behind application traffic. Usually the same database.
DIRECT_URL="postgresql://user:password@host:5432/db"

# ---------------------------------------------------------------------------
# Cache and rate limiting
# ---------------------------------------------------------------------------
#
# NOT required to boot, but a traffic spike without them degrades: rate limits
# become per-instance (so the effective limit is multiplied by the instance
# count) and /api/stats falls back to the database.
#
# Serverless (Vercel): use Upstash, which speaks HTTP and opens no socket.
#   UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=...
# Self-hosted or a long-running container: use REDIS_URL.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Payments (REQUIRED in production)
# ---------------------------------------------------------------------------
#
# Without these the site issues NO tickets and serves a waitlist instead. That
# is deliberate. The previous build fell back to a mock provider and handed out
# paid tickets for free whenever the keys went missing, which is the single most
# damaging failure in this codebase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Amount in cents for the reservation. Must match the Stripe Price you create.
STRIPE_PRICE_CENTS=1000

# Simulates payment in development and test ONLY. Ignored in production: the
# flag is false there regardless of its value, so no configuration mistake can
# turn a paid site into a free one.
MOCK_PAYMENTS=false

# ---------------------------------------------------------------------------
# Email (REQUIRED in production)
# ---------------------------------------------------------------------------
#
# Without these, confirmations queue in the outbox and never arrive. /api/health
# reports that as degraded rather than pretending mail was sent.
# Verify the sending domain with SPF, DKIM and DMARC before going live, or
# Resend and Gmail will both reject or spam-bin the messages.
RESEND_API_KEY=
EMAIL_FROM="Sleep Contest <tickets@yourdomain.com>"

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
#
# REQUIRED in production. Generate the hash with:
#   npm run admin:hash -- "the password"
# The hash is dot-separated, not the conventional dollar-separated form: a `.env`
# file is shell-flavoured, and sourcing one (`source .env`, `set -a; . .env`,
# Docker `env_file`, systemd) expands `$1` and `$8` as positional parameters and
# silently deletes them. Quote the value in your deployment if you use a shell.
#
# There is deliberately no way to set a plaintext admin password.
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. REQUIRED, at least 32 characters of random
# string. `openssl rand -base64 48`
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
#
# REQUIRED in production. Guards /api/cron/sweep. `openssl rand -base64 32`
CRON_SECRET=

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
#
# REQUIRED in production, at least 16 characters. Salt for hashing client IPs
# before they are stored, so a leaked database cannot be used to reconstruct who
# registered from where. Rotating it changes every stored hash and every future
# rate-limit key.
IP_PEPPER=

# ---------------------------------------------------------------------------
# Optional: bot protection (recommended before a launch)
# ---------------------------------------------------------------------------
#
# When set, the register form requires a valid Turnstile token. When absent the
# check is skipped entirely and the form relies on rate limits and the honeypot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: error reporting
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Client-editable settings are NOT here
# ---------------------------------------------------------------------------
#
# The registration cap, the goal, the milestone ladder, the deadline, the
# sponsor, the world's-contests section and the record-attempt badge are edited
# from /admin and stored in the database, not in this file. That is what makes
# them changeable without a developer and a deploy.

# ---------------------------------------------------------------------------
# Build-time content flags
# ---------------------------------------------------------------------------

# Anything left blank is hidden rather than rendered as a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ORGANIZER_ADDRESS=
NEXT_PUBLIC_CONTEST_DEADLINE=
NEXT_PUBLIC_SPONSOR=

# Hide the numeral below this many paid registrations. 0, the default, means the
# real count is always shown including zero. Raise it only if a zero at launch
# is a problem for the campaign. Editable from admin, which wins.
NEXT_PUBLIC_COUNTER_MIN_PUBLIC=0

# Safety, medical and biometric FAQ answers stay hidden until the client
# approves them. Publishing an unapproved promise about hearing protection or
# heart-rate data is worse than publishing nothing.
NEXT_PUBLIC_SAFETY_FAQ_APPROVED=false

NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_X=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Loads synthetic registrations into the LOCAL database. Never enable this
# against a database with real registrations: they would count towards the
# public total.
SEED_DEMO=false

# With a key, `npm run images:generate` writes the photographs the site expects.
# Without one it skips silently and the site keeps its dark cinematic fallback.
# GEMINI_API_KEY=
