# ---------------------------------------------------------------------------
# Copy this file to .env.local for development. Every value is optional: the
# site builds, runs and demonstrates with none of them set.
#
# What is NOT optional before a real launch is set out in DEPLOY.md, and is
# checked automatically by /api/health.
# ---------------------------------------------------------------------------

# Canonical origin. Must be https in production: it is what canonical links,
# og:url and every ticket link in a confirmation email are built from.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then to the public domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Leave blank for the mock provider, which completes instantly, takes no money
# and issues no real ticket. A production deployment on the mock provider shows
# a persistent "payments are simulated" banner and is reported as degraded by
# /api/health.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Must be set alongside the keys above, or the page keeps saying payments are
# simulated even when they are not.
NEXT_PUBLIC_STRIPE_ENABLED=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# The default is an in-memory store: the demo runs with no database at all.
# It does NOT survive a redeploy, and on a serverless host it can differ
# between requests. Set a managed PostgreSQL connection string before any real
# launch.
# DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Without these, confirmations print to the terminal and nobody receives a
# ticket link. /api/health reports that as degraded in production.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------

# Anything left blank is hidden rather than shown as a placeholder, so the page
# never renders a square bracket or a literal "undefined".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ORGANIZER_ADDRESS=
NEXT_PUBLIC_CONTEST_DEADLINE=
NEXT_PUBLIC_SPONSOR=

# Counts as a demonstration with synthetic data, and labels the counter.
NEXT_PUBLIC_DEMO_MODE=false

# The public counter shows a real number only at or above this. Below it the
# page shows the target and the story instead of a zero. The admin view is
# unaffected and always shows the true total.
NEXT_PUBLIC_COUNTER_MIN_PUBLIC=500

# Safety, medical and biometric-data FAQ answers stay hidden until the client
# approves them. Publishing an unapproved promise about hearing protection or
# heart-rate data is worse than publishing nothing.
NEXT_PUBLIC_SAFETY_FAQ_APPROVED=false

# Rendered in the footer only when set.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_X=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------

# /admin needs both. Without them the page says so rather than failing.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random

# ---------------------------------------------------------------------------
# Imagery (optional)
# ---------------------------------------------------------------------------

# With a key, `npm run images:generate` writes the photographs the site
# expects. Without one it skips silently and the site keeps its dark cinematic
# fallback, which is a valid state.
# GEMINI_API_KEY=

# SEED_DEMO=true loads sample registrations for local admin work.
SEED_DEMO=false